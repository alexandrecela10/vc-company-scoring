# ============================================================
# Company Scorer — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
# NEVER commit .env to git.
# ============================================================

# --- Gemini ---
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Tavily ---
# Get your key at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --- Langfuse ---
# Get your keys at https://cloud.langfuse.com (Settings > API Keys)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Supabase ---
# Get your keys at https://supabase.com (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Direct Postgres connection string — used by db.py (psycopg2)
# Find it at: Supabase dashboard → Project Settings → Database → URI
# IMPORTANT: Replace [YOUR-PASSWORD] with your actual DB password
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
